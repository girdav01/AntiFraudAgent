# AntiFraud Agent Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# CTI API Keys
# ============================================

# VirusTotal API Key
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Trend Micro Vision One API Key
TREND_API_KEY=your_trend_api_key_here

# ============================================
# STIX Export
# ============================================

# OpenCTI
OPENCTI_URL=http://opencti.example.com
OPENCTI_TOKEN=your_opencti_token_here

# ============================================
# Email Notifications
# ============================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here
FROM_ADDRESS=antifraud@example.com
RECIPIENT_ADDRESSES=admin@example.com,security@example.com

# ============================================
# LLM Configuration
# ============================================

# LLM Backend (local, openai, custom)
LLM_BACKEND=local

# For local models
MODEL_PATH=/models/llama-2-7b.gguf
N_GPU_LAYERS=0

# For OpenAI/Custom API
OPENAI_API_KEY=your_openai_key_here
OPENAI_API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo

# ============================================
# Agent Configuration
# ============================================

# Timezone
TZ=America/Montreal

# Scheduling
DAILY_TIME=07:00
ENABLE_DAILY_RUN=true

# Crawling limits
MAX_URLS_TO_CRAWL=50
MAX_IOCS_TO_ENRICH=100
MAX_CONCURRENT_CRAWLS=5

# ============================================
# Security
# ============================================

# Generate a random secret key for encryption
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# ============================================
# Logging
# ============================================

LOG_LEVEL=INFO
LOG_FILE=/logs/antifraud-agent.log

# ============================================
# MCP Tools
# ============================================

MCP_WEB_SEARCH_ENABLED=false
MCP_CODE_ANALYSIS_ENABLED=false
MCP_SCREENSHOT_ENABLED=false
